# Database Configuration
DATABASE_URL=postgresql://beethinking:beethinking@localhost:5432/beethinking
# For SQLite use: sqlite:///./beethinking.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=BeeThinking Backend
APP_ENV=development
DEBUG=True
ADMIN_EMAILS=admin@example.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:4201,http://localhost:3000,http://127.0.0.1:4200,http://127.0.0.1:4201

# Email (optional - for email confirmation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@beethinking.com
EMAIL_CONFIRMATION_ENABLED=False

# Google Calendar sync (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/google-calendar/oauth/callback
GOOGLE_CALENDAR_FRONTEND_URL=http://localhost:4200/appointments
GOOGLE_CALENDAR_TOKEN_KEY=

# Object storage for photos
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=beethinking
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=beethinking-photos
MINIO_SECURE=False
PHOTO_UPLOAD_MAX_BYTES=10485760
RECEIPT_UPLOAD_MAX_BYTES=20971520

# Varroa weather planning
VARROA_WEATHER_PROVIDER=internal_rules
VARROA_WEATHER_CACHE_TTL_HOURS=6
VARROA_WEATHER_OFFICIAL_ENDPOINT=
VARROA_WEATHER_OFFICIAL_API_KEY=
