# Database Configuration
DATABASE_URL=postgresql://beethinking:beethinking@localhost:5432/beethinking
# For SQLite use: sqlite:///./beethinking.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=BeeThinking Backend
APP_ENV=development
DEBUG=True

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:3000

# Email (optional - for email confirmation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@beethinking.com
EMAIL_CONFIRMATION_ENABLED=False

# Object storage for photos
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=beethinking
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=beethinking-photos
MINIO_SECURE=False
