{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**"],
  "dataGroups": [
    {
      "name": "api-reads",
      "urls": ["/api/apiaries/**", "/api/hives/**", "/api/queens**", "/api/varroa-checks**", "/api/inspection-criteria**", "/api/tasks**", "/api/feedings**", "/api/treatments**", "/api/harvests**", "/api/dashboard/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "4s",
        "maxSize": 300,
        "maxAge": "1d"
      }
    }
  ]
}
