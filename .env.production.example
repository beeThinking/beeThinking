DOMAIN=example.com

APP_NAME=BeeThinking Backend
APP_ENV=production
DEBUG=False
ADMIN_EMAILS=admin@example.com
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://example.com

POSTGRES_USER=beethinking
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=beethinking

MINIO_ACCESS_KEY=beethinking
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=beethinking-photos
PHOTO_UPLOAD_MAX_BYTES=10485760
RECEIPT_UPLOAD_MAX_BYTES=20971520

VARROA_WEATHER_PROVIDER=open_meteo
VARROA_WEATHER_CACHE_TTL_HOURS=6
VARROA_WEATHER_OFFICIAL_ENDPOINT=
VARROA_WEATHER_OFFICIAL_API_KEY=

EMAIL_CONFIRMATION_ENABLED=False
