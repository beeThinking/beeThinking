DOMAIN=example.com

APP_NAME=BeeThinking Backend
APP_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://example.com

POSTGRES_USER=beethinking
